# 이 파일은 wiki DB 저장(publish-wiki 스킬 — harness 플러그인에 내장된 agents/lib/wikihub_db/가
# 직접 읽는다, 별도 설치 불필요)과 별도 프로젝트 wiki-hub(wiki-hub-serve, 운영 계획 수립 중)
# 양쪽이 공유하는 설정이다. 대상 프로젝트 루트에 이 파일을 .env로 복사해 채우면 된다.
# .env는 git에 커밋하지 않는다(.gitignore).
#
# 비밀번호는 평문(*_PASSWORD) 또는 암호화(*_PASSWORD_ENC, 권장) 중 하나만 채우면 된다.
# 암호화하려면: python agents/lib/wikihub_db/encrypt_password.py --root . --engine mssql|postgresql|oracle
# 암호화 키는 프로젝트 루트의 .wiki_db.key 에 자동 생성된다(git 미포함) — 이 파일이 없으면 복호화 불가.

# ---- DB 엔진 선택 ----
# mssql | postgresql | oracle | sqlite
# 미지정 시 sqlite로 동작한다 (안전한 기본값 — 별도 서버 없이 파일 하나로 시험 가능).
WIKI_DB_ENGINE=mssql

# ---- SQLite (1인 사용·오프라인·시험용) ----
# 여러 harness 프로젝트에서 발행할 계획이면, 모든 프로젝트가 "같은 파일 경로"를
# 가리켜야 한다. 프로젝트마다 다른 경로를 쓰면 허브에 시스템이 하나씩만 보인다.
WIKI_SQLITE_PATH=

# ---- MSSQL (드라이버: pip install pymssql) ----
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
# 암호화해서 넣으려면 위 대신 아래를 쓴다 (권장, cryptography 패키지 필요):
#   python agents/lib/wikihub_db/encrypt_password.py --root . --engine mssql
# MSSQL_PASSWORD_ENC=
MSSQL_DATABASE=

# ---- PostgreSQL (드라이버: pip install psycopg2-binary) ----
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
# 암호화: python agents/lib/wikihub_db/encrypt_password.py --root . --engine postgresql
# PG_PASSWORD_ENC=
PG_DATABASE=

# ---- Oracle (드라이버: pip install oracledb, Instant Client 불필요) ----
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=
# 암호화: python agents/lib/wikihub_db/encrypt_password.py --root . --engine oracle
# ORACLE_PASSWORD_ENC=

# ---- 고급: 위 항목 대신 SQLAlchemy URL을 직접 줄 수도 있다 ----
# 지정하면 WIKI_DB_ENGINE과 무관하게 이 값을 그대로 쓴다.
# 예) postgresql+psycopg2://user:pass@host:5432/db
WIKI_DB_URL=

# ---- 이 저장소가 중앙 DB에서 갖는 좌표 ----
# WIKI_SYSTEM_KEY    : 업무 시스템 단위. 백엔드/프론트엔드 저장소가 한 시스템이면 같은 값을 쓴다.
# WIKI_SYSTEM_NAME   : 허브 목록에 보일 표시 이름.
# WIKI_COMPONENT_KEY : 시스템 안에서의 구분자. 같은 레이어가 둘 이상이면 admin-web 처럼 따로 준다.
# WIKI_COMPONENT_TYPE: backend | frontend | fullstack | batch | mobile | common
WIKI_SYSTEM_KEY=
WIKI_SYSTEM_NAME=
WIKI_COMPONENT_KEY=
WIKI_COMPONENT_TYPE=

# ---- 발행 담당자 ----
# 발행 기록(페이지 버전·발행 로그)을 사람 단위로 남기기 위해 받는다.
# 한 번 채워두면 다음 발행부터 다시 묻지 않는다(발행 시 --save-env 를 주면 자동으로 채워진다).
#
# 회사명·사번·성명은 사람을 식별하는 키라 없으면 발행이 중단된다.
#   - 사번은 "회사 안에서" 유일하면 된다. 원청·협력사 인원이 섞여도 회사명이 다르면 다른 사람으로 관리된다.
# 소속·전화번호·이메일은 없으면 경고만 하고 진행한다(허브 화면에서 나중에 채울 수 있다).
WIKI_PUBLISHER_COMPANY=
WIKI_PUBLISHER_DEPT=
WIKI_PUBLISHER_EMPNO=
WIKI_PUBLISHER_NAME=
WIKI_PUBLISHER_PHONE=
WIKI_PUBLISHER_EMAIL=
