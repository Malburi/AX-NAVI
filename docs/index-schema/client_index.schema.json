{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "client_index.json",
  "type": "object",
  "required": ["_meta", "type", "js_count", "domain_structure", "sample_mappings", "jquery_versions"],
  "properties": {
    "_meta": { "$ref": "_meta.schema.json" },
    "type": { "type": "string" },
    "build_tool": { "type": ["string", "null"] },
    "js_count": { "type": "integer" },
    "domain_structure": { "type": "object" },
    "sample_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["js", "jsps", "functions"],
        "properties": {
          "js": { "type": "string" },
          "jsps": { "type": "array", "items": { "type": "string" } },
          "functions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "jquery_versions": { "type": "array", "items": { "type": "string" } },
    "ajax_contract": { "type": "string" },
    "naming_convention": { "type": "object" },
    "anti_patterns": { "type": "array", "items": { "type": "string" } }
  }
}
